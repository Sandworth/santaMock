<mvc:View
    controllerName="custom.deposits.controller.DepositDetail"
    height="100%"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:uxap="sap.uxap"
    xmlns:layout="sap.ui.layout.form"
    xmlns:l="sap.ui.layout"
    xmlns:core="sap.ui.core"
    xmlns:commons="sap.suite.ui.commons"
    core:require="{
		Float: 'sap/ui/model/type/Float',
		Formatter: 'custom/deposits/model/formatter',
		CurrencyType: 'sap/ui/model/type/Currency',
		DateTimeType: 'sap/ui/model/type/DateTime'
	}"
>
    <uxap:ObjectPageLayout
        id="objectPageLayout"
        showTitleInHeaderContent="false"
        alwaysShowContentHeader="false"
        preserveHeaderStateOnScroll="true"
        upperCaseAnchorBar="false"
        backgroundDesignAnchorBar="Transparent"
        showFooter="true"
    >
        <!-- =========================================================== -->
        <!-- HEADER TITLE                                                 -->
        <!-- =========================================================== -->
        <uxap:headerTitle>
            <uxap:ObjectPageDynamicHeaderTitle>
                <uxap:heading>
                    <Title
                        text="{
                            parts: [
                                { path: 'mainService>tenor/description' },
                                { path: 'mainService>currency_ID' }
                            ],
                            formatter: 'Formatter.formatDepositTitle'
                        }"
                    />
                </uxap:heading>
                <uxap:snappedContent>
                    <Label
                        text="{
						path: 'mainService>rate',
						type: 'Float',
						formatOptions: { decimals: 2, maxFractionDigits: 2 }
					} %"
                        design="Bold"
                    />
                </uxap:snappedContent>
                <uxap:expandedContent>
                    <ObjectStatus
                        title="{i18n>lblRate}"
                        text="{
							path: 'mainService>rate',
							type: 'Float',
							formatOptions: { decimals: 2, maxFractionDigits: 2 }
						}"
                        state="Information"
                    />
                </uxap:expandedContent>
                <uxap:actions>
                    <OverflowToolbarButton
                        id="btnClose"
                        icon="sap-icon://decline"
                        text="{i18n>navClose}"
                        press=".handleClose"
                        visible="{= ${/actionButtonsInfo/midColumn/closeColumn} !== null }"
                    />
                </uxap:actions>
            </uxap:ObjectPageDynamicHeaderTitle>
        </uxap:headerTitle>
        <!-- =========================================================== -->
        <!-- HEADER CONTENT — Suitability                                -->
        <!-- =========================================================== -->
        <uxap:headerContent>
            <HBox>
                <VBox>
                    <!-- <Label text="{i18n>lblSuitability}" />
					<RatingIndicator
					value="{mainService>Suitability}"
					maxValue="5"
					editable="false" /> -->
                </VBox>
                <l:VerticalLayout>
                    <ObjectStatus
                        title="{i18n>lblDuration}"
                        text="{mainService>tenor/description}"
                    />
                    <ObjectStatus
                        title="{i18n>lblCurrency}"
                        text="{mainService>currency/description}"
                    />
                </l:VerticalLayout>
                <l:VerticalLayout
                    class="sapUiLargeMarginBegin"
                    visible="{intent>/isHistory}"
                >
                    <ObjectStatus
                        title="{i18n>lblStartDate}"
                        text="{
										parts: [
											{ path: 'mainService>startDate' }
										],
										formatter: 'Formatter.dateTimeToDate'
										}"
                    />
                    <ObjectStatus
                        title="{i18n>lblMaturityDate}"
                        text="{
										parts: [
											{ path: 'mainService>maturityDate' }
										],
										formatter: 'Formatter.dateTimeToDate'
										}"
                    />
                </l:VerticalLayout>
            </HBox>
        </uxap:headerContent>
        <!-- =========================================================== -->
        <!-- SECTIONS                                                     -->
        <!-- =========================================================== -->
        <uxap:sections>
            <!-- Simulation -->
            <uxap:ObjectPageSection
                titleUppercase="false"
                title="{i18n>secSimulation}"
            >
                <uxap:subSections>
                    <uxap:ObjectPageSubSection
                        showTitle="false"
                        visible="{intent>/isDisplay}"
                    >
                        <uxap:blocks>
                            <VBox class="sapUiSmallMarginTopBottom">
                                <HBox alignItems="End">
                                    <VBox>
                                        <Label
                                            text="{i18n>simAmountLabel}"
                                            required="true"
                                        />
                                        <Input
                                            id="simAmountInput"
                                            width="18rem"
                                            placeholder="{i18n>simAmountPlaceholder}"
                                            value="{simulation>/amountDisplay}"
                                            liveChange=".onSimAmountInputLiveChange"
                                            change=".onSimAmountInputChange"
                                        />
                                    </VBox>
                                    <Button
                                        class="sapUiSmallMarginBegin"
                                        text="{i18n>simCalculate}"
                                        enabled="{= Boolean(${simulation>/amount}) &amp;&amp; ${simulation>/amount} >= 10000000}"
                                        icon="sap-icon://simulate"
                                        press=".onSimulate"
                                    />
                                </HBox>
                                <Panel
                                    class="sapUiMediumMarginTop"
                                    headerText="{i18n>simResultTitle}"
                                >
                                    <content>
                                        <layout:SimpleForm
                                            editable="false"
                                            layout="ResponsiveGridLayout"
                                            labelSpanL="4"
                                            labelSpanM="4"
                                            emptySpanL="4"
                                            emptySpanM="4"
                                            columnsL="1"
                                            columnsM="1"
                                        >
                                            <layout:content>
                                                <Label
                                                    text="{i18n>simInterestLabel}"
                                                />
                                                <ObjectNumber
                                                    number="{
														path: 'simulation>/interest',
														formatter: 'Formatter.formatFloat'
													}"
                                                    unit="{simulation>/currency}"
                                                    state="Success"
                                                    emptyIndicatorMode="On"
                                                />
                                                <Label
                                                    text="{i18n>simTotalLabel}"
                                                />
                                                <ObjectNumber
                                                    emphasized="true"
                                                    number="{
														path: 'simulation>/total',
														formatter: 'Formatter.formatFloat'
													}"
                                                    unit="{simulation>/currency}"
                                                    state="Success"
                                                    emptyIndicatorMode="On"
                                                />
                                            </layout:content>
                                        </layout:SimpleForm>
                                    </content>
                                </Panel>
                            </VBox>
                        </uxap:blocks>
                    </uxap:ObjectPageSubSection>
                </uxap:subSections>
            </uxap:ObjectPageSection>
            <!-- Request Deposit -->
            <uxap:ObjectPageSection
                titleUppercase="false"
                title="{i18n>secRequest}"
            >
                <uxap:subSections>
                    <uxap:ObjectPageSubSection
                        showTitle="false"
                        visible="{intent>/isDisplay}"
                    >
                        <uxap:blocks>
                            <VBox class="sapUiSmallMarginTopBottom">
                                <Label
                                    text="{i18n>reqAccountLabel}"
                                    required="true"
                                />
                                <ComboBox
                                    id="reqAccountComboBox"
                                    width="24rem"
                                    showSecondaryValues="true"
                                    selectedKey="{request>/cuentaOrigen}"
                                    selectionChange=".onRequestAccountChange"
                                    items="{
											path: 'request>/cuentasFiltradas',
											sorter: { path: 'banco', descending: false, group: true }
										}"
                                >
                                    <core:ListItem
                                        key="{request>cuentaCorriente}"
                                        text="{request>nombre} - {request>cuentaCorriente}"
                                        additionalText="{
                                            parts: [
                                                { path: 'request>saldoInfoCent' },
                                                { path: 'request>currency' }
                                            ],
                                            type: 'CurrencyType',
                                            formatOptions: { currencyCode : false }
                                        }"
                                    />
                                </ComboBox>
                                <Label
                                    text="{i18n>reqAmountLabel}"
                                    required="true"
                                    class="sapUiSmallMarginTop"
                                />
                                <HBox>
                                    <Input
                                        id="reqAmountInput"
                                        width="18rem"
                                        placeholder="{i18n>simAmountPlaceholder}"
                                        enabled="{= !!${request>/cuentaOrigen} }"
                                        value="{request>/importeSolicitudDisplay}"
                                        liveChange=".onReqAmountInputLiveChange"
                                        change=".onReqAmountInputChange"
                                    />
                                    <Button
                                        class="sapUiSmallMarginBegin"
                                        text="{i18n>simCopy}"
									enabled="{= !!${request>/cuentaOrigen} &amp;&amp; Boolean(${simulation>/amount}) &amp;&amp; ${simulation>/amount} >= 10000000}"
                                        icon="sap-icon://copy"
                                        press=".onCopySimulation"
                                    />
                                </HBox>
                            </VBox>
                        </uxap:blocks>
                    </uxap:ObjectPageSubSection>
                </uxap:subSections>
            </uxap:ObjectPageSection>
            <uxap:ObjectPageSection
                titleUppercase="false"
                title="{i18n>secRequest}"
            >
                <uxap:ObjectPageSubSection
                    title="{i18n>detailTitle}"
                    visible="{intent>/isHistory}"
                >
                    <layout:SimpleForm
                        editable="false"
                        layout="ResponsiveGridLayout"
                    >
                        <Label visible="{intent>/isSantander}" text="{i18n>lblClient}" />
                        <Text visible="{intent>/isSantander}" text="{mainService>client/name}" />
                        <Label text="{i18n>colAmount}" />
                        <Text
                            text="{
								parts: [
									{ path: 'mainService>amount' },
									{ path: 'mainService>currency_ID' }
								],
								type: 'CurrencyType',
								formatOptions: { currencyCode : false }
								}"
                        />
                        <Label text="{i18n>lblTimeToMaturity}" />
                        <Text text="{
									path: 'mainService>maturityDate',
									type: 'DateTimeType',
									formatOptions: {
										relative: true,
										relativeScale: 'day',
                                        relativeRange: 365,
										source: { pattern: 'yyyy-MM-ddTHH:mm:ss.SSSZ' }
									}
								}" />
                    </layout:SimpleForm>
                </uxap:ObjectPageSubSection>
            </uxap:ObjectPageSection>
            <uxap:ObjectPageSection
                titleUppercase="false"
                title="{i18n>secRequest}"
            >
                <uxap:ObjectPageSubSection
                    title="{i18n>secDepositStatus}"
                    visible="{intent>/isHistory}"
                >
                    <commons:Timeline
                        id="idTimeline"
                        enableDoubleSided="false"
                        enableScroll="false"
                        showHeaderBar="false"
                        textHeight="automatic"
                        sortOldestFirst="false"
                    >
                        <commons:content>
                            <commons:TimelineItem
                                userName="{= ${intent>/isSantander} ? ${mainService>requestedBy} : ${mainService>createdBy} }"
                                icon="sap-icon://activity-individual"
                                text="{i18n>timelineDepositRequested}"
                                dateTime="{mainService>startDate}"
                            />
                            <commons:TimelineItem
                                userName="User ABC"
                                icon="sap-icon://activity-2"
                                text="{i18n>timelineDepositApproved}"
                                dateTime="{mainService>startDate}"
                            />
                        </commons:content>
                    </commons:Timeline>
                </uxap:ObjectPageSubSection>
            </uxap:ObjectPageSection>
        </uxap:sections>
        <uxap:footer>
            <OverflowToolbar visible="{intent>/isDisplay}">
                <ToolbarSpacer />
                <Button
                    id="btnRequestDeposit"
                    icon="sap-icon://request"
                    text="{i18n>depositRequest}"
                    type="Emphasized"
                    enabled="{= !!${request>/cuentaOrigen} &amp;&amp; ${request>/importeSolicitud} >= 10000000 }"
                    press=".onRequestDeposit"
                />
                <!-- <Button 
                    id="btnCancelDeposit"
                    icon="sap-icon://cancel"
                    text="{i18n>depositCancel}"
                    type="Reject"
                    press=".onCancelDeposit"
                />
                <Button 
                    id="btnTest"
                    icon="sap-icon://cancel"
                    text="{i18n>depositCancel}"
                    type="Ghost"
                    press=".onTestUpdate"
                /> -->
            </OverflowToolbar>
        </uxap:footer>
    </uxap:ObjectPageLayout>
</mvc:View>
