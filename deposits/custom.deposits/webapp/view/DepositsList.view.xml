<mvc:View
	controllerName="custom.deposits.controller.DepositsList"
	height="100%"
	xmlns:mvc="sap.ui.core.mvc"
	core:require="{
		Float: 'sap/ui/model/type/Float',
		Formatter: 'custom/deposits/model/formatter'
	}"
	xmlns="sap.m"
	xmlns:f="sap.f"
	xmlns:fb="sap.ui.comp.filterbar"
	xmlns:svm="sap.ui.comp.smartvariants"
	xmlns:vm="sap.ui.fl.variants"
	xmlns:plugins="sap.m.plugins"
	xmlns:columnmenu="sap.m.table.columnmenu"
	xmlns:dnd="sap.ui.core.dnd"
	xmlns:core="sap.ui.core"
	xmlns:u="sap.ui.unified"
	xmlns:app="http://schemas.sap.com/sapui5/extension/sap.ui.core.CustomData/1">

	<f:DynamicPage id="listPage" headerExpanded="true">

		<!-- =========================================================== -->
		<!-- TITLE — SmartVariantManagement for FilterBar                -->
		<!-- =========================================================== -->
		<f:title>
			<f:DynamicPageTitle>
				<f:heading>
					<svm:SmartVariantManagement id="svm" showExecuteOnSelection="true" />
				</f:heading>
				<f:expandedContent>
					<Label id="expandedLabel" text="{i18n>noFiltersActive}" />
				</f:expandedContent>
				<f:snappedContent>
					<Label id="snappedLabel" text="{i18n>noFiltersActive}" />
				</f:snappedContent>
			</f:DynamicPageTitle>
		</f:title>

		<!-- =========================================================== -->
		<!-- HEADER — FilterBar                                          -->
		<!-- =========================================================== -->
		<f:header>
			<f:DynamicPageHeader pinnable="true">
				<f:content>
					<fb:FilterBar
						id="filterBar"
						persistencyKey="customDepositsPersKey"
						useToolbar="false"
						search=".onSearch"
                        showClearOnFB="true"
                        clear=".onClearFilters"
						filterChange=".onFilterChange"
						afterVariantLoad=".onAfterVariantLoad">
						<fb:filterGroupItems>

						<!-- Currency -->
							<fb:FilterGroupItem
								name="Currency"
								label="{i18n>filterCurrency}"
								groupName="Group1"
								visibleInFilterBar="true">
								<fb:control>
									<MultiComboBox
										id="filterCurrency"
										selectionChange=".onSelectionChange">
										<core:ListItem key="EUR" text="EUR - Euro" />
										<core:ListItem key="USD" text="USD - US Dollar" />
										<core:ListItem key="GBP" text="GBP - British Pound" />
									</MultiComboBox>
								</fb:control>
							</fb:FilterGroupItem>

							<!-- Duration -->
							<fb:FilterGroupItem
								name="Duration"
								label="{i18n>filterDuration}"
								groupName="Group1"
								visibleInFilterBar="true">
								<fb:control>
									<MultiComboBox
										id="filterDuration"
										selectionChange=".onSelectionChange">
										<core:ListItem key="1M"  text="{i18n>tenorCode_1M}"  additionalText="1M" />
										<core:ListItem key="2M"  text="{i18n>tenorCode_2M}"  additionalText="2M" />
										<core:ListItem key="3M"  text="{i18n>tenorCode_3M}"  additionalText="3M" />
										<core:ListItem key="4M"  text="{i18n>tenorCode_4M}"  additionalText="4M" />
										<core:ListItem key="5M"  text="{i18n>tenorCode_5M}"  additionalText="5M" />
										<core:ListItem key="6M"  text="{i18n>tenorCode_6M}"  additionalText="6M" />
										<core:ListItem key="7M"  text="{i18n>tenorCode_7M}"  additionalText="7M" />
										<core:ListItem key="8M"  text="{i18n>tenorCode_8M}"  additionalText="8M" />
										<core:ListItem key="9M"  text="{i18n>tenorCode_9M}"  additionalText="9M" />
										<core:ListItem key="10M" text="{i18n>tenorCode_10M}" additionalText="10M" />
										<core:ListItem key="11M" text="{i18n>tenorCode_11M}" additionalText="11M" />
										<core:ListItem key="12M" text="{i18n>tenorCode_12M}" additionalText="12M" />
									</MultiComboBox>
								</fb:control>
							</fb:FilterGroupItem>

							<!-- Rate -->
							<fb:FilterGroupItem
								name="Rate"
								label="{i18n>filterRate}"
								groupName="Group1"
							visibleInFilterBar="true">
								<fb:control>
								<Input id="filterRate" showValueHelp="true" valueHelpOnly="true"
										   valueHelpRequest=".onRateValueHelpRequest" />
								</fb:control>
							</fb:FilterGroupItem>

						</fb:filterGroupItems>
					</fb:FilterBar>
				</f:content>
			</f:DynamicPageHeader>
		</f:header>

		<!-- =========================================================== -->
		<!-- CONTENT — Table with p13n                                   -->
		<!-- =========================================================== -->
		<f:content>
				<!-- growingThreshold="20" -->
			<Table
				id="depositsTable"
				inset="false"
				growing="false"
				sticky="ColumnHeaders,HeaderToolbar"
				autoPopinMode="true"
				fixedLayout="Strict"
				popinLayout="GridSmall"
				ariaLabelledBy="tableTitle"
				updateFinished=".onTableUpdateFinished"
                width="100%"
						items="{
							path: 'mainService>/RateGrid',
							length: 24,
							filters: [
								{ path: 'rate', operator: 'GT', value1: 0 }
							],
							sorter: [
								{ path: 'createdAt', descending: true },
								{ path: 'currency/order' },
								{ path: 'tenor/order' }
							]
						}">

				<!-- Header Toolbar -->
				<headerToolbar>
					<OverflowToolbar>
						<Title id="tableTitle" text="{i18n>listTitle}" />
						<ToolbarSeparator />
						<Text id="lastUpdateLabel" text="{i18n>lastUpdate}: " />
						<vm:VariantManagement id="tableVm" for="depositsTable" visible="false"/>
						<ToolbarSpacer />
					<u:FileUploader
						id="fileUploader"
						name="myFileUpload"
						tooltip="Upload your file to the local server"
						uploadComplete=".handleUploadComplete"/>
					<Button
						text="Upload File"
						press=".handleUploadPress"/>						
						<!-- <u:FileUploader
							id="fileUploader"
							name="myFileUpload"
							uploadOnChange="true"
							useMultipart="false"
							sendXHR="true"
							buttonOnly="true"
							buttonText="Update Rates"
							uploadUrl="odata/deposits/postFixTermDeposits"
							uploadComplete=".handleUploadComplete"/>						 -->
						<Button
							icon="sap-icon://customer-order-entry"
                            text="{i18n>newDeposit}"
							tooltip="{i18n>newDepositTooltip}"
                            type="Ghost"
							press=".onOpenCustomReq" />
						<Button
							icon="sap-icon://action-settings"
							tooltip="{i18n>settingsTooltip}"
							press=".onOpenSettings" />
					</OverflowToolbar>
				</headerToolbar>

				<!-- Info toolbar (active filters indicator) -->
				<infoToolbar>
					<OverflowToolbar id="filterInfo" visible="false" design="Info" active="true" press=".onFilterInfoPress">
						<Text id="filterInfoText" wrapping="false" text="" />
						<ToolbarSpacer />
						<Button
							icon="sap-icon://decline"
							type="Transparent"
							press=".onClearFilters" />
					</OverflowToolbar>
				</infoToolbar>

				<!-- p13n plugins -->
				<dependents>
					<plugins:ColumnResizer columnResize=".onColumnResize" />
					<columnmenu:Menu id="columnMenu" beforeOpen=".onBeforeOpenColumnMenu" showTableSettingsButton="true" tableSettingsPressed=".onOpenSettings">
						<columnmenu:QuickSort change=".onSort">
							<columnmenu:items>
								<columnmenu:QuickSortItem />
							</columnmenu:items>
						</columnmenu:QuickSort>
						<columnmenu:QuickGroup change=".onGroup">
							<columnmenu:items>
								<columnmenu:QuickGroupItem />
							</columnmenu:items>
						</columnmenu:QuickGroup>
					</columnmenu:Menu>
				</dependents>

				<!-- Column drag-drop -->
				<dragDropConfig>
					<dnd:DragDropInfo
						sourceAggregation="columns"
						targetAggregation="columns"
						dropPosition="Between"
						drop=".onColumnMove" />
				</dragDropConfig>

				<noData>
					<IllustratedMessage />
				</noData>

				<!-- Columns -->
				<columns>
					<Column app:p13nKey="currency_col">
						<Text text="{i18n>colCurrency}" />
					</Column>
					<Column app:p13nKey="duration_col">
						<Text text="{i18n>colDuration}" />
					</Column>
					<Column app:p13nKey="rate_col">
						<Text text="{i18n>colRate}" />
					</Column>
					<!-- <Column app:p13nKey="name_col">
						<Text text="{i18n>colName}" />
					</Column> -->
					<!-- <Column app:p13nKey="suitability_col">
						<Text text="{i18n>colSuitability}" />
					</Column> -->
				</columns>

				<!-- Row template -->
				<items>
					<ColumnListItem type="Navigation" press=".onListItemPress" class="listItemCustHeight">
						<cells>
							<Text text="{mainService>currency/description}" />
							<Text text="{mainService>tenor/description}" />
							<ObjectNumber
								number="{
									path: 'mainService>rate',
									type: 'Float',
									formatOptions: { decimals: 2 }
								}"
								unit="%" />
						</cells>
					</ColumnListItem>
				</items>

			</Table>
		</f:content>

	</f:DynamicPage>
</mvc:View>
