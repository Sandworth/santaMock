<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
    <Dialog
        id="signerSelectionDialog"
        title="{signers>/dialogTitle}"
        contentWidth="40rem"
        draggable="true"
        state="Information"
        class="sapUiResponsivePadding--content"
        resizable="false">
        <content>
            <Text
                text="{signers>/confirmationText}"
                wrapping="true"
                class="sapUiSmallMarginTopBottom sapUiTinyMarginBegin" />
            <Title text="{i18n>signerSelectionTitle}" class="sapUiTinyMarginBegin" level="H4" />
            <List
                id="signerList"
                showSeparators="Inner"
                items="{signers>/signers}">
                <CustomListItem>
                    <HBox   class="sapUiTinyMarginTopBottom"
                            alignItems="Center"
				            justifyContent="SpaceBetween">
                        <CheckBox
                            selected="{signers>selected}"
                            select=".onSignerSelectionChange" />
                        <Input
                            class="sapUiTinyMarginTop"
                            width="250px"
                            value="{signers>fullName}"
                            enabled="{signers>selected}"
                        />    
                        <Input
                            class="sapUiTinyMarginTop"
                            width="250px"
                            type="Email"
                            placeholder="{i18n>signerEmailPlaceholder}"
                            value="{signers>email}"
                            enabled="{signers>selected}" />
                    </HBox>
                </CustomListItem>
            </List>
            <Text class="disclaimerText sapUiTinyMarginBegin sapUiSmallMarginTopBottom" text="{i18n>signerDisclaimer}"/>
            <CheckBox selected="{signers>/accepted}" text="{i18n>signerTerms}" class="sapUiSmallMarginBottom"/>
        </content>
        <beginButton>
            <Button text="{i18n>customReqCancelBtn}" press=".onCancelSignerSelection" />
        </beginButton>
        <endButton>
            <Button
                text="{signers>/confirmButtonText}"
                type="Emphasized"
                press=".onConfirmDepositWithSigners" />
        </endButton>
    </Dialog>
</core:FragmentDefinition>