<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.f"
    xmlns:viz="sap.viz.ui5.controls"
    xmlns:viz.data="sap.viz.ui5.data"
    xmlns:viz.feeds="sap.viz.ui5.controls.common.feeds"
    core:require="{Currency: 'sap/ui/model/type/Currency'}"
>
    <VBox>
        <viz:VizFrame
            id="saldosVizFrame"
            uiConfig="{applicationSet:'fiori'}"
            vizType="column"
            height="350px"
            width="100%"
        >
            <viz:dataset>
                <viz.data:FlattenedDataset
                    data="{
                        path: 'saldos>/',
                        filters: [
                            {
                                path: 'Currency',
                                operator: 'EQ',
                                value1: 'EUR'
                            }
                        ]
                    }"
                >
                    <viz.data:dimensions>
                        <viz.data:DimensionDefinition
                            name="CompanyName"
                            value="{CompanyName}"
                        />
                    </viz.data:dimensions>
                    <viz.data:measures>
                        <viz.data:MeasureDefinition
                            name="Balance"
                            value="{Balance}"
                        />
                    </viz.data:measures>
                </viz.data:FlattenedDataset>
            </viz:dataset>
            <viz:feeds>
                <viz.feeds:FeedItem
                    uid="categoryAxis"
                    type="Dimension"
                    values="CompanyName"
                />
                <viz.feeds:FeedItem
                    uid="valueAxis"
                    type="Measure"
                    values="Balance"
                />
            </viz:feeds>
        </viz:VizFrame>
        <List
            id="saldosList"
            backgroundDesign="Transparent"
            class="sapUiContentPadding"
            showSeparators="None"
            width="100%"
            items="{
                path: 'saldos>/'
            }"
        >
            <CustomListItem type="Inactive">
                <Panel
                    class="sapUiTinyMargin"
                    width="99%"
                >
                    <HBox
                        justifyContent="SpaceBetween"
                        width="100%"
                    >
                        <VBox
                            justifyContent="SpaceBetween"
                            class="sapUiSmallMarginBegin sapUiSmallMarginTopBottom"
                        >
                            <!-- <HBox alignItems="Center"> -->
                                <Title
                                text="{saldos>CompanyName}"
                                titleStyle="H3"
                                class="sapUiSmallMarginEnd sapUiTinyMarginTop"
                            />
                                <!-- <Button
                                    icon="sap-icon://edit"
                                    type="Transparent"
                                  /> -->
                            <!-- </HBox> -->
                            <Label text="{i18n>colCIF}: {saldos>VatNumber}" />
                        </VBox>
                        <VBox
                            alignItems="End"
                            class="sapUiSmallMarginEnd sapUiSmallMarginTopBottom"
                        >
                            <Label text="{i18n>colTotalBalance}" />
                            <Title
                                text="{
                                                parts: [
                                                    {path: 'saldos>Balance'},
                                                    {path: 'saldos>Currency'}
                                                ],
                                                type: 'Currency',
                                                formatOptions: {
                                                    currencyCode: false,
                                                    showMeasure: true
                                                }
                                            }"
                                titleStyle="H3"
                            />
                        </VBox>
                    </HBox>
                </Panel>
            </CustomListItem>
        </List>
    </VBox>
</core:FragmentDefinition>
