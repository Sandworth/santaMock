<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.f"
    xmlns:viz="sap.viz.ui5.controls"
    xmlns:viz.data="sap.viz.ui5.data"
    xmlns:viz.feeds="sap.viz.ui5.controls.common.feeds"
    core:require="{Currency: 'sap/ui/model/type/Currency'}"
>
    <VBox>
        <viz:VizFrame
            id="saldosVizFrame"
            uiConfig="{applicationSet:'fiori'}"
            vizType="column"
            height="350px"
            width="100%"
        >
            <viz:dataset>
                <viz.data:FlattenedDataset
                    data="{
                        path: 'Cashpool>/Companies',
                        filters: [
                            {
                                path: 'Currency',
                                operator: 'EQ',
                                value1: 'EUR'
                            }
                        ]
                    }"
                >
                    <viz.data:dimensions>
                        <viz.data:DimensionDefinition
                            name="CompanyName"
                            value="{CompanyName}"
                        />
                    </viz.data:dimensions>
                    <viz.data:measures>
                        <viz.data:MeasureDefinition
                            name="balance"
                            value="{balance}"
                        />
                    </viz.data:measures>
                </viz.data:FlattenedDataset>
            </viz:dataset>
            <viz:feeds>
                <viz.feeds:FeedItem
                    uid="categoryAxis"
                    type="Dimension"
                    values="CompanyName"
                />
                <viz.feeds:FeedItem
                    uid="valueAxis"
                    type="Measure"
                    values="balance"
                />
            </viz:feeds>
        </viz:VizFrame>
        <List
            backgroundDesign="Transparent"
            class="sapUiContentPadding"
            showSeparators="None"
            width="100%"
            items="{
                path: 'Cashpool>/Companies',
                filters: [
                    {
                        path: 'Currency',
                        operator: 'EQ',
                        value1: 'EUR'
                    }
                ]
            }"
        >
            <CustomListItem type="Inactive">
                <Panel
                    class="sapUiTinyMargin"
                    width="99%"
                >
                    <HBox
                        justifyContent="SpaceBetween"
                        width="100%"
                    >
                        <VBox
                            justifyContent="SpaceBetween"
                            class="sapUiSmallMarginBegin sapUiSmallMarginTopBottom"
                        >
                            <HBox alignItems="Center">
                                <Title
                                    text="{Cashpool>CompanyName}"
                                    titleStyle="H3"
                                    class="sapUiSmallMarginEnd sapUiTinyMarginTop"
                                />
                                <Button
                                    icon="sap-icon://edit"
                                    type="Transparent"
                                />
                            </HBox>
                            <Label text="{i18n>colCIF}: {Cashpool>VatNumber}" />
                        </VBox>
                        <VBox
                            alignItems="End"
                            class="sapUiSmallMarginEnd sapUiSmallMarginTopBottom"
                        >
                            <Label text="{i18n>colTotalBalance}" />
                            <Title
                                text="{
                                                parts: [
                                                    {path: 'Cashpool>balance'},
                                                    {path: 'Cashpool>Currency'}
                                                ],
                                                type: 'Currency',
                                                formatOptions: {
                                                    currencyCode: false,
                                                    showMeasure: true
                                                }
                                            }"
                                titleStyle="H3"
                            />
                        </VBox>
                    </HBox>
                </Panel>
            </CustomListItem>
        </List>
    </VBox>
</core:FragmentDefinition>
